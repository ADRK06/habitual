# Real prod values go in .env.prod (gitignored). Only DATABASE_URL is needed
# here - scripts/migrate-prod.sh uses it to run migrations against the Neon
# main branch. Use the pooled connection string.
#
# Quote the value - Neon's connection strings usually contain "&" (e.g.
# between sslmode and channel_binding params), and this file is parsed by
# python-dotenv, which (like most .env parsers) needs quotes to treat the
# whole value literally.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"
