DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY=change-me

# Transactional email (habitual/mailer.py) - EMAIL_PROVIDER picks which
# section below applies. "console" (the default if unset) just prints the
# email to this terminal instead of sending - fine for local dev, but
# must never be set (or left unset) on Vercel; the app logs a loud error
# and refuses to fake-send if it is.
EMAIL_PROVIDER=console

# EMAIL_PROVIDER=smtp - production option, via a dedicated Gmail account.
# Requires 2-Step Verification on that account, then a generated App
# Password (Google Account -> Security -> App passwords) - NOT the
# account's real password. MAIL_FROM_EMAIL must be the same address as
# SMTP_USER (Gmail only sends mail "From" the authenticated account).
# Gmail's free sending limit is ~500 messages/day - see README.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=change-me
# MAIL_FROM_EMAIL=you@gmail.com
# MAIL_FROM_NAME=Habitual
