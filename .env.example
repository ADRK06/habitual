DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
SECRET_KEY=change-me

# Transactional email (habitual/mailer.py) - EMAIL_PROVIDER picks which
# section below is read. "console" (the default if unset) just prints the
# email to this terminal instead of sending - never active on Vercel.
EMAIL_PROVIDER=console

# EMAIL_PROVIDER=brevo - https://app.brevo.com (free tier). Sender must be
# a verified single sender under Brevo's Senders page (no domain needed).
# BREVO_API_KEY=change-me
# MAIL_FROM_EMAIL=you@example.com
# MAIL_FROM_NAME=Habitual

# EMAIL_PROVIDER=smtp - e.g. a dedicated Gmail account with 2-Step
# Verification on, using a generated App Password (not the real password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=change-me
# MAIL_FROM_EMAIL=you@gmail.com
